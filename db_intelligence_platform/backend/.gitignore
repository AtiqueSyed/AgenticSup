.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Real secrets; the template stays tracked.
.env
!.env.example

# Contains live Oracle usernames/passwords in plaintext (see Settings.REGISTRY_PATH,
# default "registry.json" -- configurable). Untracked as of this branch, but it is
# still present in earlier history: every credential inside it needs rotating.
registry.json

# Any variant of the registry, not just the exact filename -- it holds plaintext
# Oracle credentials and a .bak of it was previously unignored.
registry.json*
