# --- LLM ---
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_PROJECT_ID=
DEFAULT_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# on | off -- default chain-of-thought mode for all LLM calls.
LLM_REASONING=on
# Nodes to force reasoning off for regardless of LLM_REASONING: chain-of-thought
# doesn't measurably improve their output but costs 10-25s each.
LLM_REASONING_OFF_OPERATIONS=recommend_visualizations,decompose_query,synthesize_answer

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# --- Hazelcast ---
HAZELCAST_HOST=localhost
HAZELCAST_PORT=5701
HAZELCAST_CLUSTER_NAME=dev

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTICSEARCH_INDEX_PREFIX=dbintel_

# --- Oracle (platform metadata DB) ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USERNAME=CMS
ORACLE_PASSWORD=change-me

# --- Application ---
REGISTRY_PATH=registry.json
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
MAX_SQL_RETRIES=3
LOG_LEVEL=INFO

# --- OpenTelemetry ---
OTEL_SERVICE_NAME=db-intelligence-backend
OTEL_SDK_DISABLED=false
# otlp | console | none
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Attach prompt/response bodies to spans. Off by default: prompts carry schema and sample data.
OTEL_CAPTURE_CONTENT=false
