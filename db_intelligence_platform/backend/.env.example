# --- LLM ---
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROJECT_ID=
DEFAULT_LLM_MODEL=gpt-4o-mini

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# --- Hazelcast ---
HAZELCAST_HOST=localhost
HAZELCAST_PORT=5701
HAZELCAST_CLUSTER_NAME=dev

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTICSEARCH_INDEX_PREFIX=dbintel_

# --- Oracle (platform metadata DB) ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
ORACLE_USERNAME=app_user
ORACLE_PASSWORD=change-me

# --- Application ---
REGISTRY_PATH=registry.json
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
MAX_SQL_RETRIES=3
LOG_LEVEL=INFO

# --- OpenTelemetry ---
OTEL_SERVICE_NAME=db-intelligence-backend
OTEL_SDK_DISABLED=false
# otlp | console | none
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Attach prompt/response bodies to spans. Off by default: prompts carry schema and sample data.
OTEL_CAPTURE_CONTENT=false
